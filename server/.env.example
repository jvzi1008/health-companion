# 复制本文件为 .env，填入你自己的密钥后保存
# 获取地址：
#   豆包/火山方舟：https://console.volcengine.com/ark （创建 API Key，并开通 对话/视觉理解/语音合成 模型服务）
#   DeepSeek：https://platform.deepseek.com （API Keys）

PORT=3001

# 豆包（火山方舟）API Key —— 对话 + 语音合成共用
DOUBAO_API_KEY=

# 豆包对话模型（改成你在方舟能调用的模型名）
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# 豆包视觉理解模型（用于拍药盒/体检报告/皮肤照片识别）
DOUBAO_VISION_MODEL=doubao-1-5-vision-pro-32k-250115

# 豆包语音合成（"甜美桃子 2.0" 声线；若未开通 2.0 请换 1.0 模型和灿灿声线）
DOUBAO_TTS_MODEL=doubao-tts-2.0-turbo
DOUBAO_TTS_VOICE=zh_female_tianmeitaozi_uranus_bigtts
# 1.0 备选：
# DOUBAO_TTS_MODEL=doubao-tts-1.0-turbo
# DOUBAO_TTS_VOICE=zh_female_cancan_mars_bigtts

# DeepSeek API Key（可选，和豆包二选一或都配置）
DEEPSEEK_API_KEY=
